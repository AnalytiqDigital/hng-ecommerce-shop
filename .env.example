# Supabase project > Connect > PostgreSQL connection string
DATABASE_URL=

# Supabase project URL and anon/public key are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never use NEXT_PUBLIC_ on this key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=store-assets

# Configure the Google provider in Supabase Auth and Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paystack TEST credentials only in development.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=


NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=